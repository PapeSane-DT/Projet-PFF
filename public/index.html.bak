async function chargerMonProfil() {
  const c = document.getElementById('dash-content');
  c.innerHTML = `
    <div class="dash-header"><div class="dash-title">Mon profil</div></div>
    <div class="row justify-content-center">
      <div class="col-md-6">
        <div class="stat-card p-4">
          <div class="profil-avatar">${user.role === 'agriculteur' ? '🌾' : user.role === 'client' ? '🛒' : '🚚'}</div>
          <div class="text-center mb-4">
            <h5 class="fw-bold" style="color:var(--green-dark)">${user.name}</h5>
            <span style="background:var(--green-pale);color:var(--green);padding:4px 14px;border-radius:20px;font-size:13px;font-weight:600">${user.role}</span>
          </div>
          <div class="mb-3"><label class="form-label">Nom complet</label><input type="text" class="form-control" id="profil-name" value="${user.name}"></div>
          <div class="mb-3">
            <label class="form-label">Téléphone</label>
            <input type="text" class="form-control" value="${user.telephone}" disabled style="background:#F9FAFB">
            <small class="text-muted">Le téléphone ne peut pas être modifié</small>
          </div>
          <div class="mb-4"><label class="form-label">Nouveau mot de passe</label><input type="password" class="form-control" id="profil-pwd" placeholder="Laisser vide pour ne pas changer"></div>
          <button class="btn-green" onclick="sauvegarderProfil()"><i class="bi bi-check2 me-2"></i>Sauvegarder</button>
        </div>
      </div>
    </div>
  `;
}

async function sauvegarderProfil() {
  const name = document.getElementById('profil-name').value.trim();
  const password = document.getElementById('profil-pwd').value;
  const body = {};
  if (name) body.name = name;
  if (password) body.password = password;
  if (Object.keys(body).length === 0) return showToast('Aucune modification', 'warning');
  const data = await apiFetch('PUT', '/mon-profil', body);
  if (data.user) {
    user.name = data.user.name;
    localStorage.setItem('sr_user', JSON.stringify(user));
    document.getElementById('nav-name').textContent = user.name;
    document.getElementById('sidebar-name').textContent = user.name;
    showToast('Profil modifié !', 'success');
  } else showToast(data.message || 'Erreur', 'error');
}
