      <div><div class="dash-title">Utilisateurs</div><div class="dash-subtitle">${users.length} utilisateur(s) inscrit(s)</div></div>
    </div>
    <div class="table-responsive">
      <table class="table table-custom align-middle">
        <thead><tr>
          <th>Nom</th><th>Téléphone</th><th>Rôle</th><th>Statut</th><th>Inscription</th><th>Actions</th>
        </tr></thead>
        <tbody>
          ${users.map(u => `<tr>
            <td class="fw-bold">${u.name}</td>
            <td>${u.telephone}</td>
            <td>${u.role}</td>
            <td>${u.suspendu ? '<span class="badge-vendu">Suspendu</span>' : '<span class="badge-disponible">Actif</span>'}</td>
            <td>${u.created_at?.split('T')[0] || ''}</td>
            <td>
              <div class="d-flex gap-2">
                ${u.role !== 'admin' ? `
                  <button class="btn-outline-custom btn-sm" onclick="toggleSuspendre(${u.id})">
                    ${u.suspendu ? '<i class="bi bi-check2-circle me-1"></i>Réactiver' : '<i class="bi bi-pause-circle me-1"></i>Suspendre'}
                  </button>
                  <button class="btn-danger-custom" onclick="supprimerUtilisateur(${u.id}, '${u.name}')">
                    <i class="bi bi-trash"></i>
                  </button>` : '<span class="text-muted small">Admin</span>'}
              </div>
            </td>
          </tr>`).join('')}
        </tbody>
      </table>
    </div>
  `;
}

async function toggleSuspendre(id) {
  const data = await apiFetch('PUT', '/admin/utilisateurs/' + id + '/toggle');
  if (data.message) { showToast(data.message, 'success'); chargerUtilisateurs(); }
  else showToast(data.message || 'Erreur', 'error');
}

async function supprimerUtilisateur(id, nom) {
  if (!confirm('Supprimer ' + nom + ' ?')) return;
  const data = await apiFetch('DELETE', '/admin/utilisateurs/' + id);
  if (data.message) { showToast(data.message, 'success'); chargerUtilisateurs(); }
  else showToast(data.message || 'Erreur', 'error');
}

async function chargerRecoltesAdmin() {
  loader();
  const data = await apiFetch('GET', '/admin/recoltes');
  const recoltes = Array.isArray(data) ? data : [];
  const c = document.getElementById('dash-content');
  c.innerHTML = `
    <div class="dash-header"><div class="dash-title">Toutes les récoltes</div><div class="dash-subtitle">${recoltes.length} récolte(s) sur la plateforme</div></div>
    <div class="table-responsive">
      <table class="table table-custom align-middle">
        <thead><tr>
          <th>Produit</th><th>Agriculteur</th><th>Zone</th><th>Quantité</th><th>Prix/kg</th><th>Date</th><th>Statut</th>
        </tr></thead>
        <tbody>
          ${recoltes.map(r => `<tr>
            <td class="fw-bold">${r.produit}</td>
            <td>${r.agriculteur?.name || 'N/A'}</td>
            <td>${r.zone}</td>
            <td>${Number(r.quantite).toLocaleString()} kg</td>
            <td>${Number(r.prix_unitaire).toLocaleString()} FCFA</td>
            <td>${r.date_recolte}</td>
            <td>${statusBadge(r.statut)}</td>
          </tr>`).join('')}
        </tbody>
      </table>
    </div>
  `;
}

async function chargerCommandesAdmin() {
  loader();
  const data = await apiFetch('GET', '/admin/commandes');
  const commandes = Array.isArray(data) ? data : [];
  const c = document.getElementById('dash-content');
  c.innerHTML = `
    <div class="dash-header"><div class="dash-title">Toutes les commandes</div><div class="dash-subtitle">${commandes.length} commande(s) sur la plateforme</div></div>
    <div class="table-responsive">
      <table class="table table-custom align-middle">
        <thead><tr>
          <th>Produit</th><th>Client</th><th>Transporteur</th><th>Quantité</th><th>Montant</th><th>Date</th><th>Statut</th>
        </tr></thead>
        <tbody>
          ${commandes.map(cmd => `<tr>
            <td class="fw-bold">${cmd.recolte?.produit || 'N/A'}</td>
            <td>${cmd.client?.name || 'N/A'}</td>
            <td>${cmd.transporteur?.name || '<span class="text-muted">Non assigné</span>'}</td>
            <td>${cmd.quantite || 'N/A'} kg</td>
            <td class="fw-bold">${fmt(cmd.montant_total)}</td>
            <td>${cmd.created_at?.split('T')[0] || ''}</td>
            <td>${statusBadge(cmd.statut)}</td>
          </tr>`).join('')}
        </tbody>
      </table>
    </div>
  `;
}
// INIT
if (token && user) initDashboard();
</script>
</body>
</html>