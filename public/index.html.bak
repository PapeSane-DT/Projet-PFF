<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
const API = 'http://127.0.0.1:8000/api';
let token = localStorage.getItem('sr_token');
let user = JSON.parse(localStorage.getItem('sr_user') || 'null');
let selectedRole = '';
let mesRecoltesData = [];
let toutesCommandes = [];
let toutesVentes = [];

// ===== UTILITAIRES =====
function showPage(p) {
  document.querySelectorAll('.page').forEach(el => el.classList.remove('active'));
  document.getElementById('page-' + p).classList.add('active');
  window.scrollTo(0, 0);
}

function showToast(msg, type = '') {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.className = 'toast-custom show ' + type;
  setTimeout(() => t.className = 'toast-custom', 3500);
}

function fmt(n) { return Number(n).toLocaleString('fr-FR') + ' FCFA'; }

function loader() {
  document.getElementById('dash-content').innerHTML = '<div class="loader-box"><div class="spinner-border spinner-green"></div></div>';
}

function activateTab(el, fn) {
  document.querySelectorAll('.sidebar-btn').forEach(i => i.classList.remove('active'));
  el.classList.add('active');
  fn();
}

function ouvrirModalPublier() {
  new bootstrap.Modal(document.getElementById('modal-publier')).show();
}

function statusBadge(statut) {
  const map = {
    'disponible': '<span class="badge-disponible">Disponible</span>',
    'vendu': '<span class="badge-vendu">Vendu</span>',
    'en_attente': '<span class="badge-en_attente">En attente</span>',
    'en_attente_confirmation': '<span class="badge-en_attente_confirmation">⏳ Attente confirmation</span>',
    'payé': '<span class="badge-payé">✅ Confirmé</span>',
    'en_livraison': '<span class="badge-en_livraison">🚚 En livraison</span>',
    'livré': '<span class="badge-livré">✅ Livré</span>',
    'livre': '<span class="badge-livre">✅ Livré</span>',
  };
  return map[statut] || `<span class="badge bg-secondary">${statut}</span>`;
}

async function apiFetch(method, path, body = null) {
  const headers = { 'Content-Type': 'application/json', 'Accept': 'application/json' };
  if (token) headers['Authorization'] = 'Bearer ' + token;
  try {
    const res = await fetch(API + path, { method, headers, body: body ? JSON.stringify(body) : null });
    return res.json();
  } catch(e) {
    return { message: 'Erreur de connexion. Vérifiez que Laravel est démarré.' };
  }
}

// ===== AUTH =====
function selectRole(role, el) {
  selectedRole = role;
  document.querySelectorAll('.role-card').forEach(o => o.classList.remove('selected'));
  el.classList.add('selected');
}

async function register() {
  const errEl = document.getElementById('register-error');
  errEl.classList.add('d-none');
  const name = document.getElementById('reg-name').value.trim();
  const telephone = document.getElementById('reg-tel').value.trim();
  const password = document.getElementById('reg-pwd').value;
  if (!name || !telephone || !password || !selectedRole) {
    errEl.textContent = 'Tous les champs sont requis.';
    errEl.classList.remove('d-none');
    return;
  }
  const data = await apiFetch('POST', '/auth/register', { name, telephone, password, role: selectedRole });
  if (data.token) {
    token = data.token;
    user = data.user;
    localStorage.setItem('sr_token', token);
    localStorage.setItem('sr_user', JSON.stringify(user));
    initDashboard();
  } else {
    errEl.textContent = data.message || "Erreur lors de l'inscription.";
    errEl.classList.remove('d-none');
  }
}

async function login() {
  const errEl = document.getElementById('login-error');
  errEl.classList.add('d-none');
  const telephone = document.getElementById('login-tel').value.trim();
  const password = document.getElementById('login-pwd').value;
  if (!telephone || !password) {
    errEl.textContent = 'Téléphone et mot de passe requis.';
    errEl.classList.remove('d-none');
    return;
  }
  const data = await apiFetch('POST', '/auth/login', { telephone, password });
  if (data.token) {
    token = data.token;
    user = data.user || { telephone, role: 'client', name: telephone };
    localStorage.setItem('sr_token', token);
    localStorage.setItem('sr_user', JSON.stringify(user));
    initDashboard();
  } else {
    errEl.textContent = data.message || 'Identifiants incorrects.';
    errEl.classList.remove('d-none');
  }
}

async function logout() {
  await apiFetch('POST', '/auth/logout');
  token = null; user = null;
  localStorage.removeItem('sr_token'); localStorage.removeItem('sr_user');
  document.getElementById('nav-auth').style.display = 'flex';
  document.getElementById('nav-user').style.display = 'none';
  showPage('home');
  showToast('Déconnexion réussie', 'success');
}

function initDashboard() {
  document.getElementById('nav-auth').style.display = 'none';
  document.getElementById('nav-user').style.display = 'flex';
  document.getElementById('nav-name').textContent = user?.name || '';
  document.getElementById('nav-role').textContent = user?.role || '';
  document.getElementById('sidebar-name').textContent = user?.name || '';
  document.getElementById('sidebar-role').textContent = user?.role || '';
  ['agriculteur','client','transporteur'].forEach(r => document.getElementById('menu-' + r).style.display = 'none');
  if (user?.role) document.getElementById('menu-' + user.role).style.display = 'block';
  showPage('dashboard');
  if (user?.role === 'agriculteur') { chargerMesRecoltes(); verifierNotifications(); setInterval(verifierNotifications, 30000); }
  else if (user?.role === 'client') { chargerMarche(); verifierNotifications(); setInterval(verifierNotifications, 30000); }
  else if (user?.role === 'transporteur') chargerLivraisons();
}

async function verifierNotifications() {
  if (!user) return;
  if (user.role === 'agriculteur') {
    const data = await apiFetch('GET', '/commandes-sur-mes-recoltes');
    const commandes = Array.isArray(data) ? data : [];
    const n = commandes.filter(c => c.statut === 'en_attente').length;
    const badge = document.getElementById('notif-agri');
    if (badge) { badge.style.display = n > 0 ? 'inline' : 'none'; badge.textContent = n; }
  }
  if (user.role === 'client') {
    const data = await apiFetch('GET', '/mes-commandes');
    const commandes = Array.isArray(data) ? data : [];
    const n = commandes.filter(c => c.statut === 'payé').length;
    const badge = document.getElementById('notif-badge');
    if (badge) { badge.style.display = n > 0 ? 'inline' : 'none'; badge.textContent = n; }
  }
}

// ===== AGRICULTEUR =====
async function chargerMesRecoltes() {
  loader();
  const data = await apiFetch('GET', '/mes-recoltes');
  const recoltes = Array.isArray(data) ? data : [];
  mesRecoltesData = recoltes;
  const dispo = recoltes.filter(r => r.statut === 'disponible').length;
  const vendu = recoltes.filter(r => r.statut === 'vendu').length;
  const attente = recoltes.filter(r => r.statut === 'en_attente_confirmation').length;
  const c = document.getElementById('dash-content');
  c.innerHTML = `
    <div class="dash-header d-flex justify-content-between align-items-start">
      <div><div class="dash-title">Mes récoltes</div><div class="dash-subtitle">Gérez vos annonces de récoltes</div></div>
      <button class="btn-primary-custom" onclick="ouvrirModalPublier()"><i class="bi bi-plus-lg me-1"></i>Nouvelle récolte</button>
    </div>
    <div class="row g-3 mb-4">
      <div class="col-md-3"><div class="stat-card"><div class="stat-icon" style="background:#DCFCE7">🌾</div><div class="stat-value">${recoltes.length}</div><div class="stat-label">Total publiées</div></div></div>
      <div class="col-md-3"><div class="stat-card"><div class="stat-icon" style="background:#D1FAE5">✅</div><div class="stat-value" style="color:#065F46">${dispo}</div><div class="stat-label">Disponibles</div></div></div>
      <div class="col-md-3"><div class="stat-card"><div class="stat-icon" style="background:#FEF9C3">⏳</div><div class="stat-value" style="color:#854D0E">${attente}</div><div class="stat-label">En attente</div></div></div>
      <div class="col-md-3"><div class="stat-card"><div class="stat-icon" style="background:#FEE2E2">💰</div><div class="stat-value" style="color:#991B1B">${vendu}</div><div class="stat-label">Vendues</div></div></div>
    </div>
    ${recoltes.length === 0 ? `
      <div class="empty-state">
        <div class="empty-icon">🌱</div>
        <div class="empty-title">Aucune récolte publiée</div>
        <div class="empty-text">Publiez votre première récolte pour commencer à vendre.</div>
        <button class="btn-primary-custom mt-3" onclick="ouvrirModalPublier()"><i class="bi bi-plus-lg me-1"></i>Publier maintenant</button>
      </div>` : `
    <div class="row g-3">
      ${recoltes.map(r => `
      <div class="col-md-6 col-lg-4">
       <div class="product-card">
          ${r.image ? `<img src="http://127.0.0.1:8000/storage/${r.image}" style="width:100%;height:160px;object-fit:cover;">` : ''}
          <div class="product-card-header">
            <div class="product-card-name">${r.produit}</div>
            <div class="product-card-zone"><i class="bi bi-geo-alt me-1"></i>${r.zone}</div>
          </div>
          <div class="product-card-body">
            <div class="product-row"><span class="product-row-label">Quantité</span><span class="product-row-value">${Number(r.quantite).toLocaleString()} kg</span></div>
            <div class="product-row"><span class="product-row-label">Prix unitaire</span><span class="product-row-value">${Number(r.prix_unitaire).toLocaleString()} FCFA/kg</span></div>
            <div class="product-row"><span class="product-row-label">Total estimé</span><span class="product-row-value">${fmt(r.quantite * r.prix_unitaire)}</span></div>
            <div class="product-row"><span class="product-row-label">Date récolte</span><span class="product-row-value">${r.date_recolte}</span></div>
          </div>
          <div class="product-card-footer">
            ${statusBadge(r.statut)}
            <div class="d-flex gap-2">
              ${r.statut === 'disponible' ? `
                <button class="btn-outline-custom btn-sm" onclick='ouvrirModalModifier(${r.id})'><i class="bi bi-pencil me-1"></i>Modifier</button>
                <button class="btn-danger-custom" onclick="supprimerRecolte(${r.id})"><i class="bi bi-trash"></i></button>` : ''}
              ${r.statut === 'en_attente_confirmation' ? `
                <button class="btn-gold" onclick="confirmerVente(${r.id})"><i class="bi bi-check2-circle me-1"></i>Confirmer</button>` : ''}
            </div>
          </div>
        </div>
      </div>`).join('')}
    </div>`}
  `;
}

function ouvrirModalModifier(id) {
  const r = mesRecoltesData.find(r => r.id === id);
  if (!r) return;
  document.getElementById('mod-id').value = r.id;
  document.getElementById('mod-produit').value = r.produit;
  document.getElementById('mod-quantite').value = r.quantite;
  document.getElementById('mod-prix').value = r.prix_unitaire;
  document.getElementById('mod-zone').value = r.zone;
  document.getElementById('mod-date').value = r.date_recolte;
  new bootstrap.Modal(document.getElementById('modal-modifier')).show();
}

async function modifierRecolte() {
  const id = document.getElementById('mod-id').value;
  const produit = document.getElementById('mod-produit').value.trim();
  const quantite = document.getElementById('mod-quantite').value;
  const prix_unitaire = document.getElementById('mod-prix').value;
  const zone = document.getElementById('mod-zone').value.trim();
  const date_recolte = document.getElementById('mod-date').value;
  if (!produit || !quantite || !prix_unitaire || !zone || !date_recolte) return showToast('Tous les champs sont requis', 'error');
  const data = await apiFetch('PUT', '/recoltes/' + id, { produit, quantite, prix_unitaire, zone, date_recolte });
  if (data.recolte) {
    bootstrap.Modal.getInstance(document.getElementById('modal-modifier'))?.hide();
    showToast('Récolte modifiée !', 'success');
    chargerMesRecoltes();
  } else showToast(data.message || 'Erreur', 'error');
}

async function publierRecolte() {
  const produit = document.getElementById('pub-produit').value.trim();
  const quantite = document.getElementById('pub-quantite').value;
  const prix_unitaire = document.getElementById('pub-prix').value;
  const zone = document.getElementById('pub-zone').value.trim();
  const date_recolte = document.getElementById('pub-date').value;
  const imageFile = document.getElementById('pub-image').files[0];

  if (!produit || !quantite || !prix_unitaire || !zone || !date_recolte)
    return showToast('Tous les champs sont requis', 'error');

  // Utiliser FormData pour envoyer l'image
  const formData = new FormData();
  formData.append('produit', produit);
  formData.append('quantite', quantite);
  formData.append('prix_unitaire', prix_unitaire);
  formData.append('zone', zone);
  formData.append('date_recolte', date_recolte);
  if (imageFile) formData.append('image', imageFile);

  const headers = { 'Accept': 'application/json' };
  if (token) headers['Authorization'] = 'Bearer ' + token;

  try {
    const res = await fetch(API + '/recoltes', {
      method: 'POST',
      headers: headers,
      body: formData
    });
    const data = await res.json();
    if (data.recolte) {
      bootstrap.Modal.getInstance(document.getElementById('modal-publier'))?.hide();
      showToast('Récolte publiée !', 'success');
      ['pub-produit','pub-quantite','pub-prix','pub-zone','pub-date','pub-image'].forEach(id => document.getElementById(id).value = '');
      chargerMesRecoltes();
    } else {
      showToast(data.message || 'Erreur', 'error');
    }
  } catch(e) {
    showToast('Erreur de connexion', 'error');
  }
}

async function supprimerRecolte(id) {
  if (!confirm('Supprimer cette récolte ?')) return;
  await apiFetch('DELETE', '/recoltes/' + id);
  showToast('Récolte supprimée', 'success');
  chargerMesRecoltes();
}

async function confirmerVente(recolte_id) {
  if (!confirm('Confirmer la vente de cette récolte ?')) return;
  const data = await apiFetch('GET', '/commandes-sur-mes-recoltes');
  const commandes = Array.isArray(data) ? data : [];
  const commande = commandes.find(c => c.recolte_id === recolte_id);
  if (!commande) return showToast('Commande introuvable', 'error');
  const result = await apiFetch('PUT', '/commandes/' + commande.id + '/confirmer');
  if (result.commande) { showToast('Vente confirmée !', 'success'); chargerMesRecoltes(); }
  else showToast(result.message || 'Erreur', 'error');
}

async function chargerCommandesSurMesRecoltes() {
  loader();
  const data = await apiFetch('GET', '/commandes-sur-mes-recoltes');
  const commandes = Array.isArray(data) ? data : [];
  const enAttente = commandes.filter(c => c.statut === 'en_attente').length;
  const enLivraison = commandes.filter(c => c.statut === 'en_livraison').length;
  const c = document.getElementById('dash-content');
  c.innerHTML = `
    <div class="dash-header"><div class="dash-title">Commandes reçues</div><div class="dash-subtitle">Gérez les commandes de vos clients</div></div>
    <div class="row g-3 mb-4">
      <div class="col-md-4"><div class="stat-card"><div class="stat-value">${commandes.length}</div><div class="stat-label">Total</div></div></div>
      <div class="col-md-4"><div class="stat-card"><div class="stat-value" style="color:#854D0E">${enAttente}</div><div class="stat-label">En attente</div></div></div>
      <div class="col-md-4"><div class="stat-card"><div class="stat-value" style="color:#1E40AF">${enLivraison}</div><div class="stat-label">En livraison</div></div></div>
    </div>
    ${commandes.length === 0 ? `
      <div class="empty-state"><div class="empty-icon">📭</div><div class="empty-title">Aucune commande reçue</div><div class="empty-text">Les commandes de vos clients apparaîtront ici.</div></div>` : `
    <div class="row g-3">
      ${commandes.map(cmd => `
      <div class="col-md-6 col-lg-4">
        <div class="product-card">
          <div class="product-card-header">
            <div class="product-card-name">${cmd.recolte?.produit || 'Produit'}</div>
            <div class="product-card-zone"><i class="bi bi-geo-alt me-1"></i>${cmd.recolte?.zone || ''}</div>
          </div>
          <div class="product-card-body">
            <div class="product-row"><span class="product-row-label"><i class="bi bi-person me-1"></i>Client</span><span class="product-row-value"><a href="#" onclick="voirProfilClient(${cmd.client?.id})" style="color:var(--green)">${cmd.client?.name || 'N/A'}</a></span></div>
            <div class="product-row"><span class="product-row-label">Téléphone</span><span class="product-row-value">${cmd.client?.telephone || 'N/A'}</span></div>
            <div class="product-row"><span class="product-row-label">Quantité</span><span class="product-row-value">${cmd.quantite || 'N/A'} kg</span></div>
            <div class="product-row"><span class="product-row-label">Montant</span><span class="product-row-value">${fmt(cmd.montant_total)}</span></div>
            <div class="product-row"><span class="product-row-label">Date</span><span class="product-row-value">${cmd.created_at?.split('T')[0] || ''}</span></div>
          </div>
          <div class="product-card-footer">
            ${statusBadge(cmd.statut)}
            ${cmd.statut === 'en_attente' ? `<button class="btn-primary-custom" onclick="confirmerCommande(${cmd.id})"><i class="bi bi-check2-circle me-1"></i>Confirmer</button>` : ''}
          </div>
        </div>
      </div>`).join('')}
    </div>`}
  `;
}

async function confirmerCommande(id) {
  if (!confirm('Confirmer cette commande ?')) return;
  const data = await apiFetch('PUT', '/commandes/' + id + '/confirmer');
  if (data.commande) { showToast('Commande confirmée !', 'success'); chargerCommandesSurMesRecoltes(); }
  else showToast(data.message || 'Erreur', 'error');
}

async function chargerHistoriqueVentes() {
  loader();
  const data = await apiFetch('GET', '/commandes-sur-mes-recoltes');
  const commandes = Array.isArray(data) ? data : [];
  toutesVentes = commandes;
  const c = document.getElementById('dash-content');
  c.innerHTML = `
    <div class="dash-header d-flex justify-content-between align-items-start">
      <div><div class="dash-title">Historique des ventes</div></div>
      <div class="d-flex gap-2 flex-wrap">
        <button class="btn-outline-custom btn-sm" onclick="filtrerVentes('tous')">Toutes</button>
        <button class="btn-outline-custom btn-sm" onclick="filtrerVentes('en_attente')">En attente</button>
        <button class="btn-outline-custom btn-sm" onclick="filtrerVentes('payé')">Confirmées</button>
        <button class="btn-outline-custom btn-sm" onclick="filtrerVentes('en_livraison')">En livraison</button>
        <button class="btn-outline-custom btn-sm" onclick="filtrerVentes('livré')">Livrées</button>
      </div>
    </div>
    <div id="liste-ventes">${renderVentes(commandes)}</div>
  `;
}

function renderVentes(commandes) {
  if (commandes.length === 0) return `<div class="empty-state"><div class="empty-icon">📊</div><div class="empty-title">Aucune vente</div></div>`;
  return `
    <div class="table-responsive">
      <table class="table table-custom align-middle">
        <thead><tr>
          <th>Produit</th><th>Client</th><th>Téléphone</th><th>Quantité</th><th>Montant</th><th>Date</th><th>Statut</th>
        </tr></thead>
        <tbody>
          ${commandes.map(cmd => `<tr>
            <td class="fw-bold">${cmd.recolte?.produit || 'N/A'}</td>
            <td><a href="#" onclick="voirProfilClient(${cmd.client?.id})" style="color:var(--green)">${cmd.client?.name || 'N/A'}</a></td>
            <td>${cmd.client?.telephone || 'N/A'}</td>
            <td>${cmd.quantite || 'N/A'} kg</td>
            <td class="fw-bold">${fmt(cmd.montant_total)}</td>
            <td>${cmd.created_at?.split('T')[0] || ''}</td>
            <td>${statusBadge(cmd.statut)}</td>
          </tr>`).join('')}
        </tbody>
      </table>
    </div>`;
}

function filtrerVentes(statut) {
  const f = statut === 'tous' ? toutesVentes : toutesVentes.filter(c => c.statut === statut || (statut === 'livré' && c.statut === 'livre'));
  document.getElementById('liste-ventes').innerHTML = renderVentes(f);
}

async function voirProfilClient(id) {
  const data = await apiFetch('GET', '/client/' + id);
  if (!data.client) return showToast('Erreur', 'error');
  const c = document.getElementById('dash-content');
  c.innerHTML = `
    <div class="d-flex align-items-center gap-3 mb-4">
      <button class="btn-outline-custom" onclick="chargerHistoriqueVentes()"><i class="bi bi-arrow-left me-1"></i>Retour</button>
      <div class="dash-title">Profil du client</div>
    </div>
    <div class="row justify-content-center">
      <div class="col-md-6">
        <div class="stat-card text-center mb-3">
          <div class="profil-avatar">🛒</div>
          <h5 class="fw-bold" style="color:var(--green-dark)">${data.client.name}</h5>
          <p class="text-muted mb-1"><i class="bi bi-phone me-1"></i>${data.client.telephone}</p>
          <p class="text-muted small">Membre depuis ${data.client.membre_depuis}</p>
        </div>
        <div class="row g-3">
          <div class="col-6"><div class="stat-card text-center"><div class="stat-value">${data.statistiques.total_commandes}</div><div class="stat-label">Total commandes</div></div></div>
          <div class="col-6"><div class="stat-card text-center"><div class="stat-value" style="color:#065F46">${data.statistiques.commandes_livrees}</div><div class="stat-label">Livrées</div></div></div>
        </div>
      </div>
    </div>
  `;
}

// ===== CLIENT =====
async function chargerMarche(zone = '') {
  bootstrap.Modal.getInstance(document.getElementById('modal-filtre'))?.hide();
  loader();
  const path = zone ? '/recoltes?zone=' + encodeURIComponent(zone) : '/recoltes';
  const data = await apiFetch('GET', path);
  const recoltes = Array.isArray(data) ? data : [];
  const c = document.getElementById('dash-content');
  c.innerHTML = `
    <div class="dash-header d-flex justify-content-between align-items-start">
      <div><div class="dash-title">Marché${zone ? ' — ' + zone : ''}</div><div class="dash-subtitle">${recoltes.length} récolte(s) disponible(s)</div></div>
      <button class="btn-outline-custom" data-bs-toggle="modal" data-bs-target="#modal-filtre"><i class="bi bi-funnel me-1"></i>Filtrer</button>
    </div>
    ${recoltes.length === 0 ? `
      <div class="empty-state"><div class="empty-icon">🌿</div><div class="empty-title">Aucune récolte disponible${zone ? ' dans cette zone' : ''}</div>
      ${zone ? '<button class="btn-primary-custom mt-3" onclick="chargerMarche()">Voir tout</button>' : ''}</div>` : `
    <div class="row g-3">
      ${recoltes.map(r => `
      <div class="col-md-6 col-lg-4">
        <div class="product-card">
          ${r.image ? `<img src="http://127.0.0.1:8000/storage/${r.image}" style="width:100%;height:160px;object-fit:cover;">` : ''}
          <div class="product-card-header">
            <div class="product-card-name">${r.produit}</div>
            <div class="product-card-zone"><i class="bi bi-geo-alt me-1"></i>${r.zone}</div>
          </div>
          <div class="product-card-body">
            <div class="product-row"><span class="product-row-label"><i class="bi bi-person me-1"></i>Agriculteur</span><span class="product-row-value">${r.agriculteur?.name || 'N/A'}</span></div>
            <div class="product-row"><span class="product-row-label">Quantité dispo</span><span class="product-row-value">${Number(r.quantite).toLocaleString()} kg</span></div>
            <div class="product-row"><span class="product-row-label">Prix unitaire</span><span class="product-row-value">${Number(r.prix_unitaire).toLocaleString()} FCFA/kg</span></div>
            <div class="product-row"><span class="product-row-label">Date récolte</span><span class="product-row-value">${r.date_recolte}</span></div>
          </div>
          <div class="product-card-footer">
            ${statusBadge(r.statut)}
            <button class="btn-gold" onclick="commander(${r.id}, ${r.quantite})"><i class="bi bi-cart-plus me-1"></i>Commander</button>
          </div>
        </div>
      </div>`).join('')}
    </div>`}
  `;
}

async function filtrerRecoltes() {
  const zone = document.getElementById('filtre-zone').value.trim();
  chargerMarche(zone);
}

async function commander(recolte_id, quantite_dispo) {
  const quantite = prompt(`Combien de kg voulez-vous commander ?\n(Maximum disponible : ${quantite_dispo} kg)`);
  if (!quantite) return;
  if (isNaN(quantite) || quantite <= 0) return showToast('Quantité invalide', 'error');
  if (Number(quantite) > quantite_dispo) return showToast('Quantité dépasse le stock disponible', 'error');
  if (!confirm(`Commander ${quantite} kg ?`)) return;
  const data = await apiFetch('POST', '/commandes', { recolte_id, quantite: parseFloat(quantite) });
  if (data.commande) {
    showToast('✅ Commande passée ! ' + (data.montant || '') + ' — ' + (data.quantite_restante || ''), 'success');
    chargerMarche();
  } else showToast(data.message || 'Erreur', 'error');
}

async function chargerMesCommandes() {
  loader();
  const data = await apiFetch('GET', '/mes-commandes');
  const commandes = Array.isArray(data) ? data : [];
  toutesCommandes = commandes;
  const enAttente = commandes.filter(c => c.statut === 'en_attente').length;
  const enLivraison = commandes.filter(c => c.statut === 'en_livraison').length;
  const livrees = commandes.filter(c => c.statut === 'livré' || c.statut === 'livre').length;
  const c = document.getElementById('dash-content');
  c.innerHTML = `
    <div class="dash-header d-flex justify-content-between align-items-start">
      <div><div class="dash-title">Mes commandes</div></div>
      <div class="d-flex gap-2 flex-wrap">
        <button class="btn-outline-custom btn-sm" onclick="filtrerCommandes('tous')">Toutes</button>
        <button class="btn-outline-custom btn-sm" onclick="filtrerCommandes('en_attente')">En attente</button>
        <button class="btn-outline-custom btn-sm" onclick="filtrerCommandes('en_livraison')">En livraison</button>
        <button class="btn-outline-custom btn-sm" onclick="filtrerCommandes('livré')">Livrées</button>
      </div>
    </div>
    <div class="row g-3 mb-4">
      <div class="col-md-3"><div class="stat-card"><div class="stat-value">${commandes.length}</div><div class="stat-label">Total</div></div></div>
      <div class="col-md-3"><div class="stat-card"><div class="stat-value" style="color:#854D0E">${enAttente}</div><div class="stat-label">En attente</div></div></div>
      <div class="col-md-3"><div class="stat-card"><div class="stat-value" style="color:#1E40AF">${enLivraison}</div><div class="stat-label">En livraison</div></div></div>
      <div class="col-md-3"><div class="stat-card"><div class="stat-value" style="color:#065F46">${livrees}</div><div class="stat-label">Livrées</div></div></div>
    </div>
    <div id="liste-commandes">${renderCommandes(commandes)}</div>
  `;
}

function renderCommandes(commandes) {
  if (commandes.length === 0) return `<div class="empty-state"><div class="empty-icon">📦</div><div class="empty-title">Aucune commande</div><div class="empty-text">Visitez le marché pour passer votre première commande.</div></div>`;
  return `<div class="row g-3">${commandes.map(cmd => `
    <div class="col-12">
      <div class="product-card">
        <div class="row g-0">
          <div class="col-md-3">
            <div class="product-card-header h-100 d-flex flex-column justify-content-center" style="border-radius:12px 0 0 12px">
              <div class="product-card-name">${cmd.recolte?.produit || 'Produit'}</div>
              <div class="product-card-zone"><i class="bi bi-geo-alt me-1"></i>${cmd.recolte?.zone || ''}</div>
              <div class="mt-2" style="font-size:12px;opacity:0.75">${cmd.created_at?.split('T')[0] || ''}</div>
            </div>
          </div>
          <div class="col-md-5 product-card-body">
            <div class="product-row"><span class="product-row-label">Quantité commandée</span><span class="product-row-value">${cmd.quantite || 'N/A'} kg</span></div>
            <div class="product-row"><span class="product-row-label">Montant total</span><span class="product-row-value">${fmt(cmd.montant_total)}</span></div>
            <div class="product-row"><span class="product-row-label">Agriculteur</span><span class="product-row-value">${cmd.recolte?.agriculteur?.name || 'N/A'}</span></div>
            ${cmd.transporteur ? `<div class="product-row"><span class="product-row-label"><i class="bi bi-truck me-1"></i>Transporteur</span><span class="product-row-value">${cmd.transporteur?.name}</span></div>` : ''}
          </div>
          <div class="col-md-4 p-3 d-flex flex-column justify-content-between">
            <div>
              <div style="font-size:12px;font-weight:600;color:#6B7280;margin-bottom:10px">SUIVI DE COMMANDE</div>
              ${suiviCommande(cmd.statut)}
            </div>
            <div class="mt-2">
              ${statusBadge(cmd.statut)}
              ${(cmd.statut === 'en_attente' || cmd.statut === 'en_attente_confirmation') ? `
                <button class="btn-danger-custom mt-2 w-100" onclick="annulerCommande(${cmd.id})"><i class="bi bi-x-circle me-1"></i>Annuler</button>` : ''}
            </div>
          </div>
        </div>
      </div>
    </div>`).join('')}</div>`;
}

function suiviCommande(statut) {
  const etapes = [
    { key: 'en_attente', label: 'Commandé', icon: '🛒' },
    { key: 'payé', label: 'Confirmé', icon: '✅' },
    { key: 'en_livraison', label: 'En livraison', icon: '🚚' },
    { key: 'livré', label: 'Livré', icon: '🏠' },
  ];
  const ordre = ['en_attente', 'payé', 'en_livraison', 'livré', 'livre'];
  const idx = ordre.indexOf(statut);
  return etapes.map((e, i) => `
    <div class="suivi-step">
      <div class="suivi-dot ${i < idx ? 'suivi-dot-done' : i === idx ? 'suivi-dot-active' : 'suivi-dot-pending'}">${e.icon}</div>
      <span style="font-size:12px;font-weight:${i === idx ? '600' : '400'};color:${i <= idx ? '#1A1A1A' : '#9CA3AF'}">${e.label}</span>
      ${i === idx ? '<span style="background:#DCFCE7;color:#166534;font-size:10px;padding:2px 8px;border-radius:20px;font-weight:600">En cours</span>' : ''}
    </div>`).join('');
}

function filtrerCommandes(statut) {
  const f = statut === 'tous' ? toutesCommandes : toutesCommandes.filter(c => c.statut === statut || (statut === 'livré' && c.statut === 'livre'));
  document.getElementById('liste-commandes').innerHTML = renderCommandes(f);
}

async function annulerCommande(id) {
  if (!confirm('Annuler cette commande ?')) return;
  const data = await apiFetch('DELETE', '/commandes/' + id);
  if (data.message) { showToast('Commande annulée !', 'success'); toutesCommandes = []; chargerMesCommandes(); }
  else showToast(data.message || 'Erreur', 'error');
}

// ===== TRANSPORTEUR =====
async function chargerLivraisons() {
  loader();
  const data = await apiFetch('GET', '/commandes-disponibles');
  const commandes = Array.isArray(data) ? data : [];
  const c = document.getElementById('dash-content');
  c.innerHTML = `
    <div class="dash-header d-flex justify-content-between align-items-start">
      <div><div class="dash-title">Livraisons disponibles</div><div class="dash-subtitle">${commandes.length} livraison(s) à prendre en charge</div></div>
      <button class="btn-outline-custom" onclick="chargerLivraisons()"><i class="bi bi-arrow-clockwise me-1"></i>Actualiser</button>
    </div>
    ${commandes.length === 0 ? `
      <div class="empty-state"><div class="empty-icon">🚚</div><div class="empty-title">Aucune livraison disponible</div><div class="empty-text">Les nouvelles commandes confirmées apparaîtront ici.</div></div>` : `
    <div class="row g-3">
      ${commandes.map(cmd => `
      <div class="col-md-6 col-lg-4">
        <div class="product-card">
          <div class="product-card-header">
            <div class="product-card-name">${cmd.recolte?.produit || 'Produit'}</div>
            <div class="product-card-zone"><i class="bi bi-geo-alt me-1"></i>${cmd.recolte?.zone || ''}</div>
          </div>
          <div class="product-card-body">
            <div class="product-row"><span class="product-row-label"><i class="bi bi-person me-1"></i>Client</span><span class="product-row-value">${cmd.client?.name || 'N/A'}</span></div>
            <div class="product-row"><span class="product-row-label">Téléphone</span><span class="product-row-value">${cmd.client?.telephone || 'N/A'}</span></div>
            <div class="product-row"><span class="product-row-label">Quantité</span><span class="product-row-value">${cmd.quantite || 'N/A'} kg</span></div>
            <div class="product-row"><span class="product-row-label">Montant</span><span class="product-row-value">${fmt(cmd.montant_total)}</span></div>
            <div class="product-row"><span class="product-row-label">Zone</span><span class="product-row-value">${cmd.recolte?.zone || 'N/A'}</span></div>
          </div>
          <div class="product-card-footer">
            ${statusBadge(cmd.statut)}
            <button class="btn-primary-custom" onclick="assignerLivraison(${cmd.id})"><i class="bi bi-truck me-1"></i>Prendre en charge</button>
          </div>
        </div>
      </div>`).join('')}
    </div>`}
  `;
}

async function assignerLivraison(id) {
  if (!confirm('Prendre en charge cette livraison ?')) return;
  const data = await apiFetch('PUT', '/commandes/' + id + '/assign-transport');
  if (data.commande) { showToast('✅ Livraison prise en charge !', 'success'); chargerLivraisons(); }
  else showToast(data.message || 'Erreur', 'error');
}

async function chargerMesLivraisons() {
  loader();
  const data = await apiFetch('GET', '/mes-livraisons');
  const commandes = Array.isArray(data) ? data : [];
  const enCours = commandes.filter(c => c.statut === 'en_livraison').length;
  const terminees = commandes.filter(c => c.statut === 'livré' || c.statut === 'livre').length;
  const c = document.getElementById('dash-content');
  c.innerHTML = `
    <div class="dash-header"><div class="dash-title">Mes livraisons</div></div>
    <div class="row g-3 mb-4">
      <div class="col-md-4"><div class="stat-card"><div class="stat-value">${commandes.length}</div><div class="stat-label">Total</div></div></div>
      <div class="col-md-4"><div class="stat-card"><div class="stat-value" style="color:#1E40AF">${enCours}</div><div class="stat-label">En cours</div></div></div>
      <div class="col-md-4"><div class="stat-card"><div class="stat-value" style="color:#065F46">${terminees}</div><div class="stat-label">Terminées</div></div></div>
    </div>
    ${commandes.length === 0 ? `
      <div class="empty-state"><div class="empty-icon">📦</div><div class="empty-title">Aucune livraison effectuée</div></div>` : `
    <div class="row g-3">
      ${commandes.map(cmd => `
      <div class="col-md-6 col-lg-4">
        <div class="product-card">
          <div class="product-card-header">
            <div class="product-card-name">${cmd.recolte?.produit || 'Produit'}</div>
            <div class="product-card-zone"><i class="bi bi-geo-alt me-1"></i>${cmd.recolte?.zone || ''}</div>
          </div>
          <div class="product-card-body">
            <div class="product-row"><span class="product-row-label">Client</span><span class="product-row-value">${cmd.client?.name || 'N/A'}</span></div>
            <div class="product-row"><span class="product-row-label">Téléphone</span><span class="product-row-value">${cmd.client?.telephone || 'N/A'}</span></div>
            <div class="product-row"><span class="product-row-label">Quantité</span><span class="product-row-value">${cmd.quantite || 'N/A'} kg</span></div>
            <div class="product-row"><span class="product-row-label">Montant</span><span class="product-row-value">${fmt(cmd.montant_total)}</span></div>
            <div class="product-row"><span class="product-row-label">Date</span><span class="product-row-value">${cmd.created_at?.split('T')[0] || ''}</span></div>
          </div>
          <div class="product-card-footer">
            ${statusBadge(cmd.statut)}
            ${cmd.statut === 'en_livraison' ? `<button class="btn-primary-custom" onclick="marquerLivre(${cmd.id})"><i class="bi bi-check2 me-1"></i>Marquer livré</button>` : ''}
          </div>
        </div>
      </div>`).join('')}
    </div>`}
  `;
}

async function marquerLivre(id) {
  if (!confirm('Confirmer la livraison ?')) return;
  const data = await apiFetch('PUT', '/commandes/' + id + '/livre');
  if (data.commande) { showToast('✅ Livraison confirmée !', 'success'); chargerMesLivraisons(); }
  else showToast(data.message || 'Erreur', 'error');
}

// ===== STATISTIQUES =====
async function chargerStatistiques() {
  loader();
  const data = await apiFetch('GET', '/statistiques');
  const c = document.getElementById('dash-content');

  if (user.role === 'agriculteur') {
    c.innerHTML = `
      <div class="dash-header"><div class="dash-title">Mes statistiques</div></div>
      <div class="row g-3 mb-4">
        <div class="col-md-3"><div class="stat-card"><div class="stat-icon" style="background:#DCFCE7">🌾</div><div class="stat-value">${data.total_recoltes}</div><div class="stat-label">Total récoltes</div></div></div>
        <div class="col-md-3"><div class="stat-card"><div class="stat-icon" style="background:#D1FAE5">✅</div><div class="stat-value" style="color:#065F46">${data.recoltes_disponibles}</div><div class="stat-label">Disponibles</div></div></div>
        <div class="col-md-3"><div class="stat-card"><div class="stat-icon" style="background:#FEE2E2">💰</div><div class="stat-value" style="color:#991B1B">${data.recoltes_vendues}</div><div class="stat-label">Vendues</div></div></div>
        <div class="col-md-3"><div class="stat-card"><div class="stat-icon" style="background:#D1FAE5">💵</div><div class="stat-value" style="color:#065F46;font-size:20px">${fmt(data.revenus_total)}</div><div class="stat-label">Revenus totaux</div></div></div>
      </div>
      <div class="stat-card p-4">
        <h6 class="fw-bold mb-3" style="color:var(--green-dark)">📊 Résumé</h6>
        <p class="text-muted mb-0">Vous avez publié <strong>${data.total_recoltes}</strong> récoltes dont <strong>${data.recoltes_vendues}</strong> vendues et <strong>${data.recoltes_disponibles}</strong> encore disponibles. Vos revenus totaux s'élèvent à <strong>${fmt(data.revenus_total)}</strong>.</p>
      </div>
    `;
    chargerStatsProduits();
  }

  if (user.role === 'client') {
    c.innerHTML = `
      <div class="dash-header"><div class="dash-title">Mes statistiques</div></div>
      <div class="row g-3 mb-4">
        <div class="col-md-4"><div class="stat-card"><div class="stat-icon" style="background:#DBEAFE">🛒</div><div class="stat-value">${data.total_commandes}</div><div class="stat-label">Total commandes</div></div></div>
        <div class="col-md-4"><div class="stat-card"><div class="stat-icon" style="background:#D1FAE5">✅</div><div class="stat-value" style="color:#065F46">${data.commandes_livrees}</div><div class="stat-label">Livrées</div></div></div>
        <div class="col-md-4"><div class="stat-card"><div class="stat-icon" style="background:#FEF9C3">💵</div><div class="stat-value" style="color:#854D0E;font-size:20px">${fmt(data.total_depense)}</div><div class="stat-label">Total dépensé</div></div></div>
      </div>
      <div class="stat-card p-4">
        <h6 class="fw-bold mb-3" style="color:var(--green-dark)">📊 Résumé</h6>
        <p class="text-muted mb-0">Vous avez passé <strong>${data.total_commandes}</strong> commandes dont <strong>${data.commandes_livrees}</strong> livrées. Total dépensé : <strong>${fmt(data.total_depense)}</strong>.</p>
      </div>
    `;
  }

  if (user.role === 'transporteur') {
    c.innerHTML = `
      <div class="dash-header"><div class="dash-title">Mes statistiques</div></div>
      <div class="row g-3 mb-4">
        <div class="col-md-4"><div class="stat-card"><div class="stat-icon" style="background:#DBEAFE">🚚</div><div class="stat-value">${data.total_livraisons}</div><div class="stat-label">Total livraisons</div></div></div>
        <div class="col-md-4"><div class="stat-card"><div class="stat-icon" style="background:#D1FAE5">✅</div><div class="stat-value" style="color:#065F46">${data.livraisons_terminees}</div><div class="stat-label">Terminées</div></div></div>
        <div class="col-md-4"><div class="stat-card"><div class="stat-icon" style="background:#DBEAFE">🔄</div><div class="stat-value" style="color:#1E40AF">${data.en_cours}</div><div class="stat-label">En cours</div></div></div>
      </div>
    `;
  }
}

async function chargerStatsProduits() {
  const data = await apiFetch('GET', '/commandes-sur-mes-recoltes');
  const commandes = Array.isArray(data) ? data : [];
  const produits = {};
  commandes.forEach(cmd => {
    const p = cmd.recolte?.produit || 'Inconnu';
    if (!produits[p]) produits[p] = { count: 0, montant: 0, quantite: 0 };
    produits[p].count++;
    produits[p].montant += Number(cmd.montant_total);
    produits[p].quantite += Number(cmd.quantite || 0);
  });
  const c = document.getElementById('dash-content');
  if (!c) return;
  c.innerHTML += `
    <div class="stat-card p-4 mt-3">
      <h6 class="fw-bold mb-3" style="color:var(--green-dark)">🌾 Statistiques par produit</h6>
      ${Object.keys(produits).length === 0 ? '<p class="text-muted">Aucune vente pour le moment.</p>' : `
      <div class="table-responsive">
        <table class="table table-custom">
          <thead><tr><th>Produit</th><th>Commandes</th><th>Quantité</th><th>Revenus</th></tr></thead>
          <tbody>
            ${Object.entries(produits).map(([p, s]) => `<tr>
              <td class="fw-bold">${p}</td>
              <td>${s.count}</td>
              <td>${s.quantite.toLocaleString()} kg</td>
              <td class="fw-bold" style="color:#065F46">${fmt(s.montant)}</td>
            </tr>`).join('')}
          </tbody>
        </table>
      </div>`}
    </div>
  `;
}

// ===== GRAPHIQUES =====
async function chargerGraphique() {
  const c = document.getElementById('dash-content');
  c.innerHTML = `
    <div class="dash-header"><div class="dash-title">📈 Graphiques</div></div>
    <div class="row g-3">
      <div class="col-md-6"><div class="stat-card p-4"><h6 class="fw-bold mb-3" style="color:var(--green-dark)">Revenus par produit</h6><canvas id="chart-produits" height="250"></canvas></div></div>
      <div class="col-md-6"><div class="stat-card p-4"><h6 class="fw-bold mb-3" style="color:var(--green-dark)">Statut des commandes</h6><canvas id="chart-statuts" height="250"></canvas></div></div>
    </div>
  `;
  const data = await apiFetch('GET', '/commandes-sur-mes-recoltes');
  const commandes = Array.isArray(data) ? data : [];
  const produits = {};
  commandes.forEach(cmd => {
    const p = cmd.recolte?.produit || 'Inconnu';
    produits[p] = (produits[p] || 0) + Number(cmd.montant_total);
  });
  new Chart(document.getElementById('chart-produits'), {
    type: 'bar',
    data: {
      labels: Object.keys(produits),
      datasets: [{ label: 'Revenus (FCFA)', data: Object.values(produits), backgroundColor: '#2D6A4F', borderRadius: 8 }]
    },
    options: { responsive: true, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true } } }
  });
  const statuts = {
    'En attente': commandes.filter(c => c.statut === 'en_attente').length,
    'Confirmées': commandes.filter(c => c.statut === 'payé').length,
    'En livraison': commandes.filter(c => c.statut === 'en_livraison').length,
    'Livrées': commandes.filter(c => c.statut === 'livré' || c.statut === 'livre').length,
  };
  new Chart(document.getElementById('chart-statuts'), {
    type: 'doughnut',
    data: {
      labels: Object.keys(statuts),
      datasets: [{ data: Object.values(statuts), backgroundColor: ['#B7791F', '#065F46', '#1E40AF', '#2D6A4F'], borderWidth: 0 }]
    },
    options: { responsive: true, plugins: { legend: { position: 'bottom' } } }
  });
}

